        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT ROUND(SUM(mid*trips)/SUM(trips),1) AS value FROM (SELECT CASE bucket WHEN '0-5' THEN 2.5 WHEN '05-10' THEN 7.5 WHEN '10-15' THEN 12.5 WHEN '15-20' THEN 17.5 WHEN '20-30' THEN 25 WHEN '30-45' THEN 37.5 WHEN '45-60' THEN 52.5 ELSE 75 END AS mid, trips FROM agg_duration) q"
