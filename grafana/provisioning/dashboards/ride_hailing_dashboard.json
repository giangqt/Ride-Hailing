          "rawSql": "SELECT $__timeGroup(time_bucket, '1h') AS time, SUM(pickup_count) AS pickups FROM hourly_demand WHERE $__timeFilter(time_bucket) AND ($zone = 0 OR zone_id = $zone) GROUP BY 1 ORDER BY 1"
