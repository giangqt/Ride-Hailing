          "rawSql": "SELECT 'trip_events' AS table_name, (SELECT SUM(trips) FROM agg_hour_dow) AS rows, (SELECT MAX(pickup_datetime) FROM trip_events) AS latest UNION ALL SELECT 'hourly_demand', COUNT(*), MAX(time_bucket) FROM hourly_demand UNION ALL SELECT 'forecast_results', COUNT(*), MAX(forecast_time) FROM forecast_results UNION ALL SELECT 'spatial_statistics', COUNT(*), MAX(analysis_time) FROM spatial_statistics UNION ALL SELECT 'temporal_anomalies', COUNT(*), MAX(detected_at) FROM temporal_anomalies UNION ALL SELECT 'network_flows', COUNT(*), MAX(time_window) FROM network_flows ORDER BY table_name"
