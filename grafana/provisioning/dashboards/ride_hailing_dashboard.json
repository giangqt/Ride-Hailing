    {
      "id": 1,
      "title": "Real-Time Demand Heatmap",
      "type": "geomap",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT z.centroid_lat AS latitude, z.centroid_lon AS longitude, z.zone_name AS name, SUM(h.pickup_count) AS pickups FROM hourly_demand h JOIN taxi_zones z ON z.zone_id = h.zone_id WHERE h.time_bucket BETWEEN $__timeFrom() AND $__timeTo() GROUP BY z.zone_id, z.centroid_lat, z.centroid_lon, z.zone_name HAVING SUM(h.pickup_count) > 0"
        }
      ],
      "options": {
        "view": {
          "id": "coords",
          "lat": 40.73,
          "lon": -73.94,
          "zoom": 10
        },
        "controls": {
          "showZoom": true,
          "showAttribution": true
        },
        "basemap": {
          "type": "default",
          "name": "Basemap"
        },
        "layers": [
          {
            "type": "heatmap",
            "name": "Pickup density",
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "weight": {
                "field": "pickups",
                "fixed": 1,
                "min": 0,
                "max": 1
              },
              "radius": 22,
              "blur": 18
            }
          }
        ]
      }
    },
    {
