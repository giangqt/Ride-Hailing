    {
      "id": 3,
      "title": "Borough Comparison",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT z.borough, SUM(h.pickup_count) AS pickups FROM hourly_demand h JOIN taxi_zones z ON z.zone_id = h.zone_id WHERE $__timeFilter(h.time_bucket) GROUP BY z.borough ORDER BY pickups DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "options": {
        "xField": "borough",
        "orientation": "horizontal",
        "showValue": "auto"
      }
    },
    {
      "id": 4,
      "title": "Hotspot Alerts",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT a.detected_at AS time, z.zone_name, z.borough, a.demand_current, a.demand_baseline, ROUND(a.ratio::numeric, 2) AS ratio, a.severity FROM hotspot_alerts a JOIN taxi_zones z ON z.zone_id = a.zone_id WHERE $__timeFilter(a.detected_at) ORDER BY a.detected_at DESC LIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "warning": {
                        "color": "orange",
                        "index": 0
                      },
                      "critical": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "description": "Hotspots where hourly demand >= 2x the zone's own baseline (mean hourly pickups, floor 1.0). Severity: 2.0-3.0 = warning, >=3.0 = critical. Populated by batch reconstruction of the 2x rule over historical hourly_demand; the live Spark aggregation path (Phase 3 Block 4) remains future work."
    },
    {
      "id": 5,
      "title": "Forecast vs Actual",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(time_bucket, '1h') AS time, SUM(pickup_count) AS actual FROM hourly_demand WHERE $__timeFilter(time_bucket) AND ($zone = 0 OR zone_id = $zone) GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "B",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(forecast_time, '1h') AS time, SUM(predicted_demand) AS predicted FROM forecast_results WHERE $__timeFilter(forecast_time) AND ($zone = 0 OR zone_id = $zone) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5
          }
        }
      },
      "options": {
        "legend": {
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Forecast (ARIMA/ETS) vs actual demand. Covers the top-10 demand zones modelled in Phase 4 (TriBeCa, West Chelsea/Hudson Yards, JFK, East New York, East Village, LaGuardia, Midtown Center, Times Sq, East Chelsea, Crown Heights North). Other zones show 'No data' by design."
    },
    {
      "id": 6,
      "title": "Top OD Flows (Network)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT zo.zone_name AS origin, zd.zone_name AS destination, SUM(f.trip_count) AS trips, ROUND(MAX(f.betweenness)::numeric, 4) AS max_betweenness FROM network_flows f JOIN taxi_zones zo ON zo.zone_id = f.origin_zone_id JOIN taxi_zones zd ON zd.zone_id = f.dest_zone_id WHERE $__timeFilter(f.time_window) GROUP BY zo.zone_name, zd.zone_name ORDER BY trips DESC LIMIT 25"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
